{
  "name": "jobright-local",
  "version": "0.8.3",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:chromium": "node scripts/build.mjs chromium",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:chromium": "npm run build:chromium && playwright test --project=chromium-dom --project=chromium-extension",
    "test:ui": "node tests/ui/check.mjs",
    "test:all": "npm run typecheck && npm test && npm run test:native && npm run test:e2e && npm run test:ui",
    "package": "npm run build && node scripts/package.mjs",
    "package:chromium": "npm run build:chromium && node scripts/package.mjs chromium",
    "test:native": "node --test tests/native/*.test.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.27.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "web-ext": "^9.0.0"
  }
}
